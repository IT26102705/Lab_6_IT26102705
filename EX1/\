#include<stdio.h>
#include<math.h>

int bi2dec(int bin1,int bin2,int bin3); //bi2dec - binary to decimal
int bin1;
int bin2;
int bin3;

int main(void)
{
	
	int dec=0;
       int bin1,bin2,bin3;	
	
	printf("Enter three digit binary number(ex - 1 0 1 1) :\n");
	scanf("%d %d %d",&bin1,&bin2,&bin3);
	
	if ((bin1 != 1 && bin1 != 0) || (bin2 != 1 && bin2 != 0) || (bin3 != 1 && bin3 != 0))
	{ 
		
		 printf("Invaild binary number....\n");
		
	}else{
		dec = bi2dec(bin1,bin2,bin3);
		printf("The decimal number is %d\n",dec);
	
	}
	
return 0;
}

int bi2dec(int a,int b,int c)
{

	return (c * 4 ) + (b * 2) + (a * 1) ;
}
